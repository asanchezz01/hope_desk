# Ambiente de PRODUÇÃO do Hope Desk (VPS).
#
# Copie para `/opt/hopedesk/.env` NA VPS e preencha. Este arquivo é só o molde;
# o `.env` real nunca é versionado e deve ter permissão 600.
#
# O script de deploy gera os segredos que faltarem (JWT e senha do banco) com
# `openssl rand` na própria VPS — assim eles não passam por chat, por commit
# nem por log de CI.

# ---------- Banco ----------
POSTGRES_DB=hopedesk
POSTGRES_USER=hopedesk
# Gerada pelo deploy se estiver vazia. Trocar depois exige recriar o volume.
POSTGRES_PASSWORD=

# ---------- Aplicação ----------
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# Origem EXATA do app Web. Em produção não há relaxação para rede local — uma
# origem a mais aqui é a diferença entre funcionar e "não foi possível conectar
# ao servidor" (o navegador não conta ao JavaScript que foi CORS).
CORS_ORIGIN=https://hopedesk.hopecash.tech

# Usada nos links dos e-mails de recuperação de senha.
APP_PUBLIC_URL=https://hopedesk.hopecash.tech

# ---------- JWT ----------
# Gerados pelo deploy se estiverem vazios. Precisam ser DIFERENTES entre si.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Rehash de senha (decisão de cutover) ----------
# `false` enquanto o Flask continuar no ar sobre os mesmos usuários: o Werkzeug
# NÃO lê bcrypt, então cada login no sistema novo trancaria aquele usuário fora
# do sistema antigo, sem aviso e sem volta.
#
# Vire para `true` depois que o Flask for desativado — a partir daí cada login
# converte o hash para bcrypt de forma transparente. Ver `docs/CUTOVER.md` §6.1.
PASSWORD_REHASH_ENABLED=false

# ---------- Limite de taxa ----------
# Contagem em memória: vale por instância. Com uma só instância, é o limite real.
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_LIMIT=10
THROTTLE_PASSWORD_RESET_LIMIT=3

# ---------- E-mail ----------
# Enquanto `false`, nenhuma notificação sai (nem a de recuperação de senha).
MAIL_ENABLED=false
MAIL_SMTP=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_USE_TLS=true

# ---------- Build do app Web ----------
# Entra no bundle em tempo de build; mudar exige reconstruir a imagem.
EXPO_PUBLIC_API_URL=https://hopedesk-api.hopecash.tech/api/v1

# ---------- Portas de loopback (diagnóstico por SSH) ----------
API_HOST_PORT=3002
WEB_HOST_PORT=8093
POSTGRES_HOST_PORT=5435
