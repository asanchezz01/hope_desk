# Hope Desk — backend (NestJS + Prisma)
# Copie para .env e preencha com valores locais.
# NUNCA coloque credenciais de produção neste arquivo: ele é versionado.

# ---------- Banco de dados (desenvolvimento / descartável) ----------
# Aponte sempre para um Postgres local ou descartável (infra/docker-compose.dev.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hopedesk?schema=public"

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:8081

# ---------- JWT ----------
# Gere valores fortes e distintos:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-forte-de-desenvolvimento
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-desenvolvimento
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- E-mail (Fase 07) ----------
MAIL_ENABLED=false
MAIL_SMTP=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_USE_TLS=true

# ---------- Frontend (para links em e-mails) ----------
APP_PUBLIC_URL=http://localhost:8081

# ---------- Limite de taxa (Fase 11) ----------
# Contagem EM MEMÓRIA: com mais de uma instância, cada uma conta separadamente e
# o limite efetivo vira (limite x instâncias). Escalar horizontalmente exige
# trocar o armazenamento — é aí que o Redis passa a se justificar.
# Janela de 60s para os dois primeiros; 300s para a recuperação de senha.
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_LIMIT=10
THROTTLE_PASSWORD_RESET_LIMIT=3
