# Imagem de DESENVOLVIMENTO: código montado por volume, watch ativo.
# A imagem de produção é o Dockerfile (multi-stage).
FROM node:20-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl openssl \
    && rm -rf /var/lib/apt/lists/*

# Dependências primeiro, para aproveitar cache de layer.
COPY package*.json ./
RUN npm ci

# Schema precisa existir antes do generate.
COPY prisma ./prisma/
RUN npx prisma generate

COPY . .

ENV NODE_ENV=development
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/v1/health || exit 1

CMD ["npm", "run", "start:dev"]
