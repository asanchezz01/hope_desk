// Hope Desk — schema Prisma definitivo dos domínios legados.
//
// PRINCÍPIO: paridade de armazenamento com o monólito Flask/SQLAlchemy.
// Nomes de tabela e coluna são exatamente os do legado, para permitir
// operação paralela (Flask + Node na mesma base) durante a transição.
// As decisões e desvios estão documentados em docs/LEGACY_CONTRACTS.md.
//
// Convenções de tempo (ver docs/LEGACY_CONTRACTS.md, seção "Tempo"):
//   - `created_at` e `reset_token_expires_at`: instante UTC gravado em
//     `timestamp without time zone` (paridade com `datetime.utcnow()`).
//   - `activity.started_at` / `activity.ended_at`: HORA DE PAREDE de
//     America/Sao_Paulo gravada naive (paridade com `datetime.fromisoformat`
//     de um <input type="datetime-local">). Use src/common/time/legacy-clock.ts.
//   - Tabelas novas (refresh_token) usam `timestamptz` e UTC real.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Domínios legados
// ---------------------------------------------------------------------------

/// Legado: classe User -> tabela "user" (palavra reservada; Prisma cita automaticamente).
model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(120)
  email               String    @unique @db.VarChar(120)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  /// "client" | "technician" — VarChar no legado, validado na aplicação e por CHECK.
  role                String    @db.VarChar(20)
  isSuperuser         Boolean   @default(false) @map("is_superuser")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  /// SHA-256 hex do token de recuperação (nunca o token em claro).
  resetTokenHash      String?   @map("reset_token_hash") @db.VarChar(64)
  /// Instante UTC de expiração (legado: utcnow + 2h).
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamp(6)

  clientTickets   Ticket[]       @relation("TicketClient")
  assignedTickets Ticket[]       @relation("TicketTechnician")
  activities      Activity[]     @relation("ActivityCreatedBy")
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([resetTokenHash])
  @@map("user")
}

/// Legado: classe Ticket -> tabela "ticket".
model Ticket {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  description String
  /// "aberto" | "em_andamento" | "resolvido" | "fechado".
  status      String   @default("aberto") @db.VarChar(30)
  /// Instante UTC de criação (legado: datetime.utcnow).
  /// O default é explicitamente UTC: `now()` num `timestamp` sem fuso seguiria o
  /// TimeZone da sessão do PostgreSQL, o que divergiria de `utcnow()`.
  createdAt   DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @map("created_at") @db.Timestamp(6)

  clientId       Int  @map("client_id")
  technicianId   Int? @map("technician_id")
  systemModuleId Int? @map("system_module_id")

  client       User          @relation("TicketClient", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  technician   User?         @relation("TicketTechnician", fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  systemModule SystemModule? @relation(fields: [systemModuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Legado: cascade="all, delete-orphan".
  activities   Activity[]

  @@index([clientId])
  @@index([technicianId])
  @@index([systemModuleId])
  @@index([status])
  @@index([createdAt])
  @@map("ticket")
}

/// Legado: classe Activity -> tabela "activity".
model Activity {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  notes       String
  /// Hora de parede America/Sao_Paulo, gravada naive.
  startedAt   DateTime @map("started_at") @db.Timestamp(6)
  /// Hora de parede America/Sao_Paulo, gravada naive.
  endedAt     DateTime @map("ended_at") @db.Timestamp(6)
  createdById Int      @map("created_by_id")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User   @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([createdById])
  /// Suporta a detecção de sobreposição: createdById + startedAt < end + endedAt > start.
  @@index([createdById, startedAt, endedAt])
  @@index([startedAt])
  @@index([endedAt])
  @@map("activity")
}

/// Legado: classe SystemModule -> tabela "system_module".
model SystemModule {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  tickets Ticket[]

  @@index([isActive])
  @@map("system_module")
}

/// Legado: classe SystemParameter -> tabela "system_parameter".
/// Chaves conhecidas: company_logo, company_name, company_address,
/// monthly_hours_allowance, hours_bank_closing_date.
model SystemParameter {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(120)
  value String @default("")

  @@map("system_parameter")
}

/// Legado: classe PaymentRecord -> tabela "payment_record".
/// DESVIO DOCUMENTADO: amount/paid_hours são `double precision` no legado e
/// `numeric` aqui (exigência de Decimal para dinheiro). Ver docs/LEGACY_CONTRACTS.md.
model PaymentRecord {
  id        Int      @id @default(autoincrement())
  /// Data (sem hora) do pagamento.
  paidAt    DateTime @map("paid_at") @db.Date
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  paidHours Decimal  @default(0) @map("paid_hours") @db.Decimal(10, 2)
  /// Instante UTC de criação (legado: datetime.utcnow). Default explicitamente UTC.
  createdAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @map("created_at") @db.Timestamp(6)

  @@index([paidAt])
  @@map("payment_record")
}

// ---------------------------------------------------------------------------
// Tabelas novas (não existem no legado; Flask não as toca)
// ---------------------------------------------------------------------------

/// Refresh tokens rotativos. Guarda apenas o jti; o token em si nunca é persistido.
model RefreshToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  jti           String    @unique @db.VarChar(64)
  /// jti que substituiu este token (detecção de reuso na rotação).
  replacedByJti String?   @map("replaced_by_jti") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// Trilha de auditoria (Fase 11).
///
/// Tabela NOVA, como `refresh_token`: o Flask não a conhece, então acrescentá-la
/// não afeta a operação paralela.
///
/// `actorId` é opcional e a relação usa `onDelete: SetNull` de propósito — o
/// registro precisa sobreviver à exclusão do usuário que praticou o ato, senão a
/// trilha some justamente no caso em que ela mais importa. `actorEmail` guarda
/// uma cópia do identificador no momento do fato, pelo mesmo motivo.
model AuditLog {
  id            Int      @id @default(autoincrement())
  /// Ação em `dominio.verbo`, ex.: `user.deleted`, `auth.login_failed`.
  action        String   @db.VarChar(64)
  /// Domínio afetado: `user`, `ticket`, `payment`, `system_module`…
  entityType    String?  @map("entity_type") @db.VarChar(32)
  entityId      Int?     @map("entity_id")
  actorId       Int?     @map("actor_id")
  /// Cópia histórica: sobrevive à exclusão do ator.
  actorEmail    String?  @map("actor_email") @db.VarChar(120)
  /// Correlation ID da requisição que originou o registro.
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  /// Detalhes não sensíveis. NUNCA senha, hash ou token.
  metadata      Json?
  createdAt     DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @map("created_at") @db.Timestamp(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([action, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
