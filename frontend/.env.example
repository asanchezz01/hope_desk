# Copie para `.env` (não versionado) e ajuste.
#
# Só variáveis com o prefixo EXPO_PUBLIC_ chegam ao bundle. Justamente por isso,
# nunca coloque segredo aqui: qualquer valor abaixo é legível por quem baixar o
# app ou abrir o DevTools no Web.

# Base da API, já com o prefixo de versão. Sem barra no fim.
#   emulador Android: http://10.0.2.2:3000/api/v1
#   aparelho físico:  http://<ip-da-maquina>:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
